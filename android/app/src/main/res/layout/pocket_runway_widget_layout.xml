<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_runway_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Safe To Spend Tag & Days Left Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAFE TO SPEND"
            android:textColor="#00C853"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_runway_days_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18d left"
            android:textColor="#8E8E98"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hero Metric: Today's Safe Daily Allowance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_safe_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="2dp"
            android:text="/ day"
            android:textColor="#7A7A88"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Inset Status & Monthly Budget Runway Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inset"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Status Tag Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_status_pill"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_runway_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ON TRACK"
                android:textColor="#00C853"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_runway_budget_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No active budget"
            android:textColor="#A0A0AA"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Log Action Button -->
    <LinearLayout
        android:id="@+id/btn_log_spend"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_primary_btn"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Log Spend"
            android:textColor="#000000"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
