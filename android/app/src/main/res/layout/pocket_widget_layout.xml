<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Card Top Header: Brand, Chip, Contactless Wave, and Account Label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POCKET"
            android:textColor="#00C853"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Metallic EMV Chip Shape using ImageView for RemoteViews compatibility -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="13dp"
                android:background="@drawable/widget_chip_emv"
                android:contentDescription="@null" />

            <!-- Contactless Wave Symbol -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:text=")))"
                android:textColor="#7A7A85"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_card_wallet_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Main Account"
            android:textColor="#9E9EA8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card Digits Indicator -->
    <TextView
        android:id="@+id/widget_card_digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.1"
        android:text="•••• 2026"
        android:textColor="#5A5A66"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Inset Balance & Spending Metrics Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inset"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_balance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVAILABLE BALANCE"
            android:textColor="#8A8A96"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_total_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="₹0.00"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Sub-Metrics Strip: Today Spend + Monthly Budget Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00 Today"
                android:textColor="#EF5350"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="•"
                android:textColor="#44444E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_budget_tag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="On Budget"
                android:textColor="#00C853"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Buttons: Quick Add + Secondary Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- 1-Tap Quick Add (Primary Action) -->
        <LinearLayout
            android:id="@+id/btn_quick_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_primary_btn"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Quick Add"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary Action: Scan or Voice -->
        <LinearLayout
            android:id="@+id/btn_secondary_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="0.8"
            android:background="@drawable/widget_action_btn"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_secondary_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Scan"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
